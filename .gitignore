# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Vite cache
.vite/
*.timestamp-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.local
.env.*.local

# Test coverage
coverage/

# Misc
*.local

# Videos downloaded by the download centre (user content, often very large).
# The directory carries its own .tasks.json manifest; neither belongs in git.
downloads/

# Local data blobs. The indexed ECDICT dictionary itself (~230 MB on disk,
# ecdict.dat alone is 218 MB) is derived data and stays out of git: GitHub
# rejects files over 100 MB (GH001), so pushing it would fail every time.
# The compacted 7z snapshot of the index IS tracked, so a fresh clone can
# restore offline lookups by extracting it instead of rebuilding the index.
data/*
!data/ecdict.7z

# Local scratch files (probe output, captured build logs — never committed)
.*.txt
.preview.txt

# Stray tsc build artifacts (vite.config.ts is the real config)
vite.config.js
vite.config.d.ts
*.tsbuildinfo
